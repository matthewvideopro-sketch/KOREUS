<section class="k-section k-approach">
  <div class="k-wrap k-approach__grid">
    <div class="k-approach__img">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt }}" loading="lazy">
      {%- else -%}
        <img src="{{ 'koreous-approach.jpg' | asset_url }}" alt="Woman massaging her scalp" loading="lazy">
      {%- endif -%}
    </div>
    <div>
      <div class="k-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 class="k-h2">{{ section.settings.heading }} <em>{{ section.settings.heading_em }}</em></h2>
      <p>{{ section.settings.text_1 }}</p>
      <p>{{ section.settings.text_2 }}</p>
      <ul class="k-checks">
        {%- for i in (1..3) -%}
          {%- capture key -%}check_{{ i }}{%- endcapture -%}
          {%- if section.settings[key] != blank -%}<li><i>{% render 'koreous-icon', icon: 'check' %}</i>{{ section.settings[key] }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
      <a class="k-btn" href="{{ section.settings.button_link | default: '/collections/all' }}">{{ section.settings.button_label }} {% render 'koreous-icon', icon: 'arrow' %}</a>
      <div class="k-guarantee"><span style="width:14px;height:14px;display:inline-flex">{% render 'koreous-icon', icon: 'shield' %}</span>{{ section.settings.guarantee }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KOREOUS approach",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Koreous approach" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Great hair grows from a healthy" },
    { "type": "text", "id": "heading_em", "label": "Heading (italic green)", "default": "scalp." },
    { "type": "textarea", "id": "text_1", "label": "Paragraph 1", "default": "Most routines only treat the strands. Korean care starts one layer deeper — at the scalp, where every hair begins." },
    { "type": "textarea", "id": "text_2", "label": "Paragraph 2", "default": "Every Koreous formula follows one rule: keep the scalp clean, balanced and nourished, so your hair has the best foundation to look its fullest. Lift away buildup, soothe the skin, feed the roots." },
    { "type": "text", "id": "check_1", "label": "Point 1", "default": "Lifts away buildup and excess oil" },
    { "type": "text", "id": "check_2", "label": "Point 2", "default": "Fermented Korean botanicals" },
    { "type": "text", "id": "check_3", "label": "Point 3", "default": "Gentle enough for everyday washing" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop all products" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "guarantee", "label": "Guarantee note", "default": "30-day money-back guarantee" }
  ],
  "presets": [{ "name": "KOREOUS approach" }]
}
{% endschema %}
