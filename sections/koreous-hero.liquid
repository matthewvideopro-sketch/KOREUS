<section class="k-hero">
  <picture>
    {%- if section.settings.image_mobile != blank -%}
      <source media="(max-width:900px)" srcset="{{ section.settings.image_mobile | image_url: width: 1000 }}">
    {%- else -%}
      <source media="(max-width:900px)" srcset="{{ 'koreous-hero-mobile.jpg' | asset_url }}">
    {%- endif -%}
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2400 }}" alt="{{ section.settings.image.alt | default: 'Koreous Korean scalp care' }}" fetchpriority="high">
    {%- else -%}
      <img src="{{ 'koreous-hero.jpg' | asset_url }}" alt="Koreous Korean scalp care bars, oil and scalp brush" fetchpriority="high">
    {%- endif -%}
  </picture>
  <div class="k-hero__content">
    <div class="k-wrap">
      <div class="k-hero__box">
        {%- if section.settings.badge != blank -%}
        <div class="k-hero__badge">
          {%- if section.settings.show_stars -%}<span class="k-stars">{% for i in (1..5) %}{% render 'koreous-icon', icon: 'star' %}{% endfor %}</span>{%- endif -%}
          <span>{{ section.settings.badge }}</span>
        </div>
        {%- endif -%}
        <h1>{{ section.settings.heading_1 }}<br>{{ section.settings.heading_2 }}</h1>
        <p>{{ section.settings.text }}</p>
        <a class="k-btn" href="{{ section.settings.button_link | default: '/collections/all' }}">{{ section.settings.button_label }} {% render 'koreous-icon', icon: 'arrow' %}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KOREOUS hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image (optional — defaults to built-in)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image 9:16 (optional)" },
    { "type": "checkbox", "id": "show_stars", "label": "Show stars", "default": true },
    { "type": "text", "id": "badge", "label": "Badge text", "default": "Rooted in Korean scalp care" },
    { "type": "text", "id": "heading_1", "label": "Heading line 1", "default": "Calm scalp. Fuller-looking hair." },
    { "type": "text", "id": "heading_2", "label": "Heading line 2", "default": "Made the Korean way." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Clean, plant-powered Korean formulas that reset your scalp so your hair can look thicker, stronger and healthier with every wash." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the Koreous Bar" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "KOREOUS hero" }]
}
{% endschema %}
