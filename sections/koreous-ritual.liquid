<section class="k-section" style="padding-top:64px">
  <div class="k-wrap">
    <h2 class="k-h2" style="font-size:34px">{{ section.settings.heading }}</h2>
    <div class="k-ritual__sub">{{ section.settings.subheading }}</div>
    <div class="k-ritual__grid">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          {%- assign url = p.url -%}{%- assign title = p.title -%}
          {%- capture price -%}{{ p.price | money }}{%- endcapture -%}
          {%- capture compare -%}{% if p.compare_at_price > p.price %}{{ p.compare_at_price | money }}{% endif %}{%- endcapture -%}
        {%- else -%}
          {%- assign url = block.settings.link | default: '/collections/all' -%}{%- assign title = block.settings.title -%}
          {%- assign price = block.settings.price -%}{%- assign compare = block.settings.compare -%}
        {%- endif -%}
        <div class="k-ritual__item" {{ block.shopify_attributes }}>
          <a class="k-ritual__img" href="{{ url }}">
            {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ title }}" loading="lazy">
            {%- elsif p != blank and p.featured_image != blank -%}<img src="{{ p.featured_image | image_url: width: 400 }}" alt="{{ title }}" loading="lazy">
            {%- else -%}<img src="{{ block.settings.asset | asset_url }}" alt="{{ title }}" loading="lazy">{%- endif -%}
          </a>
          <div>
            <h3>{{ title }}</h3>
            <p>{{ block.settings.text }}</p>
            <div class="k-price" style="margin-bottom:6px">{% if compare != blank %}<s>{{ compare }}</s>{% endif %}<b style="font-size:14px">{{ price }}</b></div>
            <a class="k-link-arrow" href="{{ url }}">Shop now &rarr;</a>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KOREOUS ritual add-ons",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete your ritual" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Little extras that make every wash work harder" }
  ],
  "blocks": [{
    "type": "item", "name": "Add-on",
    "settings": [
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "image_picker", "id": "image", "label": "Image (optional)" },
      { "type": "text", "id": "asset", "label": "Built-in image file", "default": "koreous-brush.jpg" },
      { "type": "text", "id": "title", "label": "Title", "default": "Scalp Massage Brush" },
      { "type": "text", "id": "text", "label": "Text", "default": "Lifts flakes and gets blood flowing with every wash." },
      { "type": "text", "id": "price", "label": "Price", "default": "$9.99" },
      { "type": "text", "id": "compare", "label": "Compare-at price", "default": "$20.00" },
      { "type": "url", "id": "link", "label": "Link (if no product)" }
    ]
  }],
  "presets": [{ "name": "KOREOUS ritual add-ons" }]
}
{% endschema %}

